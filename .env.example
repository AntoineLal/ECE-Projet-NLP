# Copiez ce fichier en « .env » (il est exclu de Git) et renseignez VOTRE clé.
# Clé gratuite : Google AI Studio (https://aistudio.google.com/apikey). Ne la partagez jamais.

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

LLM_MAX_CALLS=15
LLM_TIMEOUT_S=25
LLM_CHAT_USE_LLM=1
